<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template
        id="report_invoice_inherit"
        inherit_id="account.report_invoice_document">
        <xpath expr="//h2" position="replace"></xpath>
        <xpath expr="//div[@id='informations']" position="replace">
            <span t-if="o.is_electronic_invoice">
                <p style="font-size:12px; margin-bottom: 0px;">
                    <span t-if="o.journal_id.resolution">
                        <strong>Resolución:</strong> <span t-field="o.journal_id.resolution" />
                    </span>
                    <span t-if="o.journal_id.prefix">
                        <strong>Prefijo:</strong> <span t-field="o.journal_id.prefix" />
                    </span>
                    <span t-if="o.journal_id.from_number">
                        <strong>Consecutivo: </strong> <span t-field="o.journal_id.from_number" /> hasta <span t-field="o.journal_id.to_number" />
                    </span>
                    <span t-if="o.journal_id.date_from">
                        <strong>Fecha: </strong> <span t-field="o.journal_id.date_from" /> hasta <span t-field="o.journal_id.date_to" />
                    </span>
                </p>
            </span>
            <div id="informations" class="mb-1">
                <table class="table table-sm o_main_table table-borderless">
                    <tbody class="invoice_tbody">
                        <tr>
                            <td width="65%">
                                <p class="mb-0">
                                    <strong t-field="o.partner_id.name"></strong>
                                </p>
                                <p class="mb-0">
                                    <strong t-field="o.partner_id.l10n_co_edi_type_document_identification_id.name"></strong>
                                    : <span t-field="o.partner_id.identification_co_number"></span>
                                </p>
                                <p class="mb-0">
                                    <strong>Teléfono</strong>
                                    : <span t-field="o.partner_id.phone"></span>
                                </p>
                                <p class="mb-0">
                                    <strong>Correo</strong>
                                    : <span t-field="o.partner_id.email"></span>
                                </p>
                                <p class="mb-0">
                                    <strong>Dirección</strong>
                                    : <span t-field="o.partner_id.contact_address"></span>
                                </p>
                                <p class="mb-0">
                                    <strong>Registro mercantil</strong>
                                    : <span t-field="o.partner_id.l10n_co_edi_merchant_registration"></span>
                                </p>
                                <p class="mb-0">
                                    <strong>Tipo de organización</strong>
                                    : <span t-field="o.partner_id.l10n_co_edi_type_organization_id.name"></span>
                                </p>
                                <p class="mb-0">
                                    <strong>Tipo de responsabilidad</strong>
                                    : <span t-field="o.partner_id.l10n_co_edi_type_liability_id.name"></span>
                                </p>
                                <p class="mb-0">
                                    <strong>Regimen</strong>
                                    : <span t-field="o.partner_id.type_regime_id.name"></span>
                                </p>
                            </td>

                            <td>
                                <span t-if="o.is_electronic_invoice">
                                    <strong class="text-uppercase">
                                        <span t-field="o.ei_type_document"/> Electrónica <br/>
                                        <span t-esc="o.number_formatted"></span>
                                    </strong>
                                    <br/>
                                </span>
                                <p t-else="">
                                    <strong>
                                        <span t-if="not proforma"></span>
                                        <span t-else="">PROFORMA</span>
                                        <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">Factura</span>
                                        <span t-elif="o.move_type == 'out_invoice' and o.state == 'draft'">Borrador de Factura</span>
                                        <span t-elif="o.move_type == 'out_invoice' and o.state == 'cancel'">Factura Cancelada</span>
                                        <span t-elif="o.move_type == 'out_refund' and o.state == 'posted'">Nota de Crédito</span>
                                        <span t-elif="o.move_type == 'out_refund' and o.state == 'draft'">Borrador de Nota de Crédito</span>
                                        <span t-elif="o.move_type == 'out_refund' and o.state == 'cancel'">Nota de Crédito Cancelada</span>
                                        <span t-elif="o.move_type == 'in_refund'">Nota de Crédito de proveedor</span>
                                        <span t-elif="o.move_type == 'in_invoice'">Factura de proveedor</span>
                                    </strong>
                                    <span t-if="o.name != '/'" t-field="o.name">INV/2023/0001</span>
                                </p>
                                <p t-attf-class="#{'mb-0 mw-100' if report_type != 'html' else 'col mb-0'}" t-if="o.invoice_date" name="invoice_date">
                                    <t t-if="o.move_type == 'out_invoice'"><strong>Fecha de factura:</strong></t>
                                    <t t-elif="o.move_type == 'out_refund'"><strong>Fecha de Nota de Crédito:</strong></t>
                                    <t t-elif="o.move_type == 'out_receipt'"><strong>Fecha de recibo:</strong></t>
                                    <t t-else=""><strong>Fecha:</strong></t>
                                    <span t-field="o.invoice_date">2023-09-12</span>
                                </p>
                                <p t-attf-class="#{'mb-0 mw-100' if report_type != 'html' else 'col mb-0'}" t-if="o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted'" name="due_date">
                                    <strong>Fecha de vto.:</strong>
                                    <span t-field="o.invoice_date_due">2023-10-31</span>
                                </p>
                                <p t-attf-class="#{'mb-0 mw-100' if report_type != 'html' else 'col mb-0'}" t-if="o.delivery_date" name="delivery_date">
                                    <strong>Fecha de entrega:</strong>
                                    <span t-field="o.delivery_date">2023-09-25</span>
                                </p>
                                <p t-attf-class="#{'mb-0 mw-100' if report_type != 'html' else 'col mb-0'}" t-if="o.invoice_origin" name="origin">
                                    <strong>Recurso:</strong>
                                    <span t-field="o.invoice_origin">SO123</span>
                                </p>
                                <p t-attf-class="#{'mb-0 mw-100' if report_type != 'html' else 'col mb-0'}" t-if="o.partner_id.ref" name="customer_code">
                                    <strong>Código de Cliente:</strong>
                                    <span t-field="o.partner_id.ref"/>
                                </p>
                                <p t-attf-class="#{'mb-0 mw-100' if report_type != 'html' else 'col mb-0'}" t-if="o.ref" name="reference">
                                    <strong>Referencia:</strong>
                                    <span t-field="o.ref">INV/2023/00001</span>
                                </p>
                                <p t-attf-class="#{'mb-0 mw-100' if report_type != 'html' else 'col mb-0'}" t-if="o.invoice_incoterm_id" name="incoterm_id">
                                    <strong>Incoterm:</strong>
                                    <p t-if="o.incoterm_location">
                                        <span t-field="o.invoice_incoterm_id.code"/>
                                        <span t-field="o.incoterm_location"/>
                                    </p>
                                    <span t-else="" t-field="o.invoice_incoterm_id.code" class="m-0"/>
                                </p>
                                <p t-attf-class="#{'mb-0 mw-100' if report_type != 'html' else 'col mb-0'}" name="currency">
                                    <strong>Moneda:</strong>
                                    <span t-field="o.currency_id.name"></span>
                                </p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </xpath>
        <xpath expr="//span[@id='payment_terms_note_id']" position="after">
            Forma de pago: <span t-field="o.payment_form_id.name"></span><br/>
            Método de pago: <span t-field="o.payment_method_id.name"></span><br/>
            <span t-if="o.company_id.display_invoice_amount_total_words">
                Valor en letras: <span t-field="o.amount_total_words" />
            </span>
        </xpath>
        <xpath expr="//p[@class='text-end lh-sm']" position="replace">
        </xpath>
    </template>
</odoo>