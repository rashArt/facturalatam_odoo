<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista heredada de account.move para agregar botón de importar XML -->
    <record id="view_account_move_form_inherit" model="ir.ui.view">
        <field name="name">account.move.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_import_xml_wizard" 
                        string="Importar Factura Electrónica" 
                        type="object" 
                        class="oe_highlight"
                        invisible="state not in ('draft') or move_type not in ('in_invoice')"
                        groups="account.group_account_invoice"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="importing_xml" invisible="1"/>
                <field name="cufe_xml" invisible="1"/>
                <field name="xml_file" invisible="1"/>
                <field name="xml_filename" invisible="1"/>
            </xpath>
            <xpath expr="//notebook" position="before">
                <group string="Información de Factura Electrónica Importada" name="xml_info" invisible="not xml_file" colspan="2" col="2">
                    <field name="xml_file" filename="xml_filename" widget="binary" readonly="1"/>
                    <field name="cufe_xml" string="CUFE" readonly="1" invisible="not cufe_xml"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Vista del wizard para importar XML -->
    <record id="view_xml_import_wizard_form" model="ir.ui.view">
        <field name="name">xml.import.wizard.form</field>
        <field name="model">xml.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar Factura Electrónica">
                <group>
                    <field name="xml_file" filename="xml_filename" required="1"/>
                    <field name="xml_filename" invisible="1"/>
                    <field name="purchase_order_id" invisible="context.get('invoice_import_mode', False)" required="not context.get('invoice_import_mode', False)"/>
                    <field name="account_move_id" invisible="not context.get('invoice_import_mode', False)" required="context.get('invoice_import_mode', False)"/>
                </group>
                <footer>
                    <button name="action_import_xml" string="Importar" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
