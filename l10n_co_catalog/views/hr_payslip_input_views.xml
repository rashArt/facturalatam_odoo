<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_payslip_input_form_view_inherit_l10n_co_catalog" model="ir.ui.view">
        <field name="name">hr.payslip.input.form.view.inherit.l10n.co.catalog</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll_community.hr_payslip_view_form"/>
        <field name="arch" type="xml">
            <!-- Modificamos la sección de input_line_ids -->
            <field name="input_line_ids" position="replace">
                <field name="input_line_ids" colspan="4" nolabel="1" readonly="state != 'draft'">
                    <tree string="Input Data" editable="bottom">
                        <field name="name"/>
                        <field name="rule_id" placeholder="Select a Salary Rule"/>
                        <field name="code"/>
                        <field name="amount"/>
                        <field name="contract_id"/>
                        <field name="sequence" invisible="True"/>
                    </tree>
                    <form string="Payslip Line">
                        <group col="4">
                            <field name="name"/>
                            <field name="rule_id" options="{'no_create': True}" placeholder="Select a Salary Rule"/>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="amount"/>
                            <field name="contract_id"/>
                        </group>
                    </form>
                </field>
            </field>
        </field>
    </record>
</odoo>