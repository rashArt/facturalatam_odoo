<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="product_template_form_view_inherit_l10n_co_edi_facturalatam" model="ir.ui.view">
            <field name="name">product.template.common.form.inherit.l10n_co_edi_facturalatam</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='categ_id']" position="after">
                    <field label="Tipo de Identificacion de producto" name="type_item_identification_id" options="{'no_open': True, 'no_create': True}"/>
                    <field name="brandname" label="Marca"/>
                    <field name="modelname" label="Modelo"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>