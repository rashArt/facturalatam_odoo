    <record id="view_co_request_edi_form" model="ir.ui.view">
        <field name="name">co.request.edi.form</field>
        <field name="model">co.request.edi</field>
        <field name="arch" type="xml">
            <form string="Request EDI">
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <field name="invoic_name" invisible="1"/>
                        <button
                            class="oe_stat_button"
                            type="object"
                            name="action_open_document_invoice_id"
                            icon="fa-file-text-o">
                            <div class="o_stat_info">
                                <field
                                    name="invoic_name"
                                    class="o_stat_value"
                                    readonly="True"
                                />
                                <span class="o_stat_text">Factura</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <field name="invoice_id" readonly="1"/>
                        <field name="status" readonly="1"/>
                        <field name="response_message" readonly="1" class="oe_inline" style="white-space: pre-wrap; overflow-wrap: break-word;"/>
                        <field name="response_xml" readonly="1" invisible="1"/>
                        <field name="response_xml_filename" invisible="1"/>
                        <field name="response_xml_binary" filename="response_xml_filename" widget='binary' readonly="1"/>
                    </group>
                    <group>
                        <field name="co_log_edi_ids">
                            <list create="false" edit="false" delete="false">
                                <field name="create_date" readonly="1"/>
                                <field name="status_code" readonly="1"/>
                                <field name="message"  readonly="1"/>
                                <field name="error_message" readonly="1" class="oe_inline" style="white-space: pre-wrap; overflow-wrap: break-word;"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
