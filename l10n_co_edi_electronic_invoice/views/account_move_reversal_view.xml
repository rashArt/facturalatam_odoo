<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="account_view_account_move_reversal_inherit_l10n_co_edi_facturalatam" model="ir.ui.view">
        <field name="name">account.move.reversal.form.inherit.l10n_co_edi_facturalatam</field>
        <field name="model">account.move.reversal</field>
        <field name="inherit_id" ref="account.view_account_move_reversal"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='reason']" position="attributes">
                <attribute name="invisible">1</attribute>
                <attribute name="required">0</attribute>
            </xpath>
            <xpath expr="//field[@name='reason']" position="after">
                <field name="journal_document_id" invisible="1"/>
                <field name="ei_correction_concept_credit_id" required="1" options="{'no_open': True, 'no_create': True}" invisible="journal_document_id == 10"/>
            </xpath>
        </field>
    </record>
</odoo>