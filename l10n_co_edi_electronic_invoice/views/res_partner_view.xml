<odoo>
    <data>
        <!-- Heredamos la vista de res.partner para modificar los campos existentes y agregar los nuevos -->
         <record id="view_partner_form_inherit_l10n_co_edi" model="ir.ui.view">
            <field name="name">res.partner.form.inherit.l10n.co.edi</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="l10n_latam_base.view_partner_latam_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[contains(@class, 'oe_title')]" position="after">
                    <group>
                        <field name="l10n_co_edi_type_document_identification_id" options="{'no_open': True, 'no_create': True}" placeholder="Type"/>
                        <field name="identification_co_number" placeholder="Número de identificación"/>
                        <button name="action_consultar_identificacion"
                            type="object"
                            string="Consultar"
                            icon="fa-search"/>
                    </group>
                </xpath>
                <xpath expr="//div[hasclass('o_address_format')]" position="after">
                    <field name="l10n_co_edi_merchant_registration" placeholder="registro mercantil"/>
                    <field name="l10n_co_edi_type_organization_id" required="0"/>
                </xpath>

                <xpath expr="//field[@name='category_id']" position="after">
                    <field name="l10n_co_edi_type_liability_id"/>
                    <field name="type_regime_id" required="0"/>
                </xpath>

                <xpath expr="//div[hasclass('o_address_format')]/field[@name='city']" position="before">
                    <field name="municipality_id" required="0" class="o_address_state" placeholder="Municipio" options="{'no_open': True, 'no_quick_create': True}"/>
                </xpath>

                <xpath expr="//label[@for='l10n_latam_identification_type_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='l10n_latam_identification_type_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='vat']" position="attributes">
                    <attribute name="readonly">1</attribute>
                </xpath>
                <xpath expr="//field[@name='vat']" position="replace"/>
            </field>
        </record>


    </data>
</odoo>
