<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="l10n_co_edi_electronic_invoice.PopupLoading">
            <div class="popup">
                <div class="modal-header">
                    <h4 class="modal-title title">
                        <t t-esc="props.title" />
                    </h4>
                </div>
                <main class="modal-body">
                    <h3 t-if="state.countdown > 0"><t t-esc="state.countdown" />...</h3>
                    <t t-esc="props.body" />
                </main>
                <t t-if="state.confirmText=='Continuar'">
                    <div class="footer footer-flex modal-footer">
                        <!-- <div class="button confirm highlight btn btn-lg btn-primary" t-on-click="confirm">
                            <t t-esc="props.confirmText" />
                        </div> -->
                        <div class="button cancel btn btn-lg btn-secondary" t-on-click="cancel">
                            <t t-esc="props.confirmText" />
                        </div>
                    </div>
                </t>
            </div>
    </t>

</templates>