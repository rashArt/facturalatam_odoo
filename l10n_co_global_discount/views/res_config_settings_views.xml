<?xml version='1.0' encoding='utf-8'?>

<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='invoicing_setting_container']" position="inside">
                <!-- <setting id="enable_global_discount" string="Enable Global Discount" help="Enable global discounts for sale orders and invoices.">
                    <field name="enable_global_discount"/>
                    <div class="content-group"  attrs="{'invisible':[('enable_global_discount', '=', False)]}" >
                        <field name="global_discount_product_id" attrs="{'required':[('enable_global_discount', '=', True)]}"  />
                    </div>
                </setting> -->
                <div class="col-12 col-lg-6 o_setting_box" id="enable_global_discount" title="Habilite descuentos globales para pedidos de venta y facturas.">
                    <div class="o_setting_left_pane">
                        <field name="enable_global_discount"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="enable_global_discount"/>
                        <div class="text-muted">
                            Habilitar descuentos globales
                        </div>
                        <div class="content-group"  invisible="enable_global_discount==False" >
                            <field name="global_discount_product_id" required="enable_global_discount==True"  />
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
