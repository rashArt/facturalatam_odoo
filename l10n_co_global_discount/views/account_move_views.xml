<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_invoice_form_inherit" model="ir.ui.view">
        <field name="name">account.move.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='narration']" position="before">
                <field name="active_global_discount" invisible="1"/>
                <group invisible="active_global_discount==False">
                    <field name="global_discount_type"/>
                    <field name="global_discount_amount"/>
                    <button name="action_apply_global_discount" type="object" string="Aplicar descuento" class="oe_highlight" icon="fa-gift"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>